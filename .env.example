# ===== LLM（OpenAI 兼容接口）=====
# provider: openai | mock（mock 用于离线验证工作流，不调用真实模型）
LLM_PROVIDER=openai
# 任意 OpenAI 兼容服务：
#   OpenAI          https://api.openai.com/v1
#   DeepSeek        https://api.deepseek.com/v1
#   通义千问(兼容)   https://dashscope.aliyuncs.com/compatible-mode/v1
#   vLLM / Ollama   http://localhost:8000/v1 等
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# ===== Embedding（Milvus 检索用，OpenAI 兼容接口；留空则复用 LLM 配置）=====
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ===== Milvus =====
# 方式1：连接 Milvus 服务  http://localhost:19530
# 方式2：Milvus Lite 本地文件  file:./milvus_lite.db （免部署，开发调试用）
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=prd_examples
MILVUS_TOP_K=3
# true: Milvus 不可用时静默降级，不影响 PRD 生成
MILVUS_FAIL_SOFT=true

# ===== 流程控制 =====
DEFAULT_MAX_ITERATIONS=2
